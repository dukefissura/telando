# Copie para .env nesta pasta. Os dois domínios precisam apontar (registro A) para o IP da VPS.
TELANDO_DOMINIO=telando.exemplo.com
LIVEKIT_DOMINIO=livekit.telando.exemplo.com

# Gere os seus: a chave pode ser qualquer texto curto; o segredo precisa de 32 caracteres ou mais.
#   openssl rand -hex 6    (chave)
#   openssl rand -base64 32 (segredo)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
