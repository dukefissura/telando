# Onde o server encontra o LiveKit. Em dev é o binário rodando com `pnpm dev:livekit`.
LIVEKIT_URL=ws://localhost:7880

# Credenciais fixas do modo --dev do LiveKit. Em produção, gere outras e nunca as commite.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Endereço público do site, usado para montar os links de sessão.
PUBLIC_BASE_URL=http://localhost:5173

PORT=8787

# 1 quando o server roda atrás do Caddy: o IP do cliente passa a vir do X-Forwarded-For.
TRUST_PROXY=0

# Quantas sessões um mesmo IP pode criar por minuto.
SESSOES_POR_MINUTO=10

# Interface onde o server escuta. Vazio escuta em todas; atrás do Caddy use 127.0.0.1.
# HOST=127.0.0.1
